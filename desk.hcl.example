# xrdesk — settings.
#
# This file is read from ~/Library/Application Support/go-xrkit/desk.hcl on
# macOS, ~/.config/go-xrkit/desk.hcl on Linux, %AppData%\go-xrkit\desk.hcl on
# Windows, or from wherever $XRDESK_CONFIG points. It does not have to exist:
# without it every default below is what you get.
#
# HCL rather than JSON for the two reasons anyone gives when asked. It takes
# comments, so a file can say WHY a shortcut was moved — which is the only part
# of a settings file worth reading six months later. And it has a schema, so a
# typo is a diagnostic pointing at a line rather than a field silently left at
# its zero value.

# The system-wide shortcuts. They work while another application has the
# keyboard, which is the difference between a desk you use and a desk you have
# to click on first.
#
# Write them however you like: "option+command+left", "Option-Command-Left" and
# "⌥⌘←" are the same combination, in any order and any case. A combination with
# no modifier is refused — claimed system-wide, a bare key is taken away from
# every application on the machine, including whatever you are typing into.
shortcut "previous" { keys = "option+command+left" }
shortcut "next"     { keys = "option+command+right" }
shortcut "gallery"  { keys = "option+command+space" }

# There is also "cycle", which shows the next source on the focused screen. It
# has no default system-wide key; bind one if you want it.
#
#   shortcut "cycle" { keys = "control+option+command+c" }

# What to add, in order, when a combination is already taken.
#
# ⌥⌘Space is the Finder's search window on a stock macOS, so the gallery always
# falls back — on this machine it lands on ⌃⌥⌘Space. Control is tried first
# because it is freer, and because ⌥⇧⌘Space puts three modifiers under one hand.
#
# `fallback = []` means do not fall back at all: give me the combination I asked
# for, or tell me you could not. That is a real thing to want, and it is
# different from leaving this line out.
fallback = ["control", "shift", "control+shift"]

ribbon {
  # How many virtual screens to put on the band. 0 asks for as many as fit
  # round the circle without overlapping — seven or eight on most glasses,
  # since one screen is one full view.
  screens = 0
}

glasses {
  # Which headset to use when several are attached, by the name the catalogue
  # gives it. Leave it out and the display is chosen the usual way.
  #
  # model = "VITURE Luma Ultra"
}

# Applications to put on the band when the desk starts.
#
# A ribbon screen is a real desktop: the cursor goes there, you click in it,
# and a window moved there stays there. This saves dragging one across from
# whatever monitor it opened on — which, while you are wearing the glasses, you
# cannot see to do.
#
# The name is a fragment, case-insensitively: "code" finds "Visual Studio
# Code", "safari" finds "Safari". Screens are counted from 1, in the plan's own
# order — screen 1 is the one the band starts facing.
#
# It needs the Accessibility grant: System Settings > Privacy & Security >
# Accessibility. Moving another application's window is the only thing on macOS
# that does, and xrdesk says so rather than silently placing nothing.
#
#   place "Safari"   { screen = 1 }
#   place "Terminal" { screen = 2 }
#   place "Mail"     { screen = 3 }

# ribbon { immersive = false }
#
# macOS draws a menu bar on EVERY display when Spaces are separate, so the
# glasses carry one of their own — 1920x30 at the top of a Beast — and it is
# drawn at a level above an ordinary window, so it lands ON TOP of the picture.
# The desktop being shown already has a menu bar in it, which is why two of
# them was the first thing anyone noticed wearing this.
#
# So the picture is put above that bar and the Dock by default. The bar on your
# other screen is untouched: it belongs to a different display and stays where
# it is.
#
# Turn this off if the glasses are your MAIN display — there the bar and the
# Dock are the real ones, not a copy on a screen nobody is looking at.
